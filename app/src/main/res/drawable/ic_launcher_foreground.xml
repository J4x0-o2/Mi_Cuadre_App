<?xml version="1.0" encoding="utf-8"?>
<!--
  Wallet with two coins, white on the black background. Separations are real gaps (even-odd
  holes and notches), never dark strokes, so the same drawable works as the monochrome layer
  for themed icons. Drawn on a 108 grid and scaled to 70% so it stays inside the 66dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.7"
        android:scaleY="0.7"
        android:translateX="15.85"
        android:translateY="16.2">
        <!-- Coin behind the wallet: disc, ring gap, inner disc. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M30,37a10,10 0,1 0,20 0a10,10 0,1 0,-20 0z M33.4,37a6.6,6.6 0,1 0,13.2 0a6.6,6.6 0,1 0,-13.2 0z M35.6,37a4.4,4.4 0,1 0,8.8 0a4.4,4.4 0,1 0,-8.8 0z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M52,31a10,10 0,1 0,20 0a10,10 0,1 0,-20 0z M55.4,31a6.6,6.6 0,1 0,13.2 0a6.6,6.6 0,1 0,-13.2 0z M57.6,31a4.4,4.4 0,1 0,8.8 0a4.4,4.4 0,1 0,-8.8 0z" />
        <!-- Wallet body with a notch for the clasp and a stitch line cut out. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M30,49H72Q80,49 80,57V58H66Q61,58 61,63V73Q61,78 66,78H80V79Q80,87 72,87H30Q22,87 22,79V57Q22,49 30,49Z M28,55H56V57.5H28Z" />
        <!-- Clasp with its button cut out. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M67,61H83Q87,61 87,65V71Q87,75 83,75H67Q64,75 64,71V65Q64,61 67,61Z M68.2,68a2.8,2.8 0,1 0,5.6 0a2.8,2.8 0,1 0,-5.6 0z" />
    </group>
</vector>
